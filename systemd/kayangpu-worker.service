[Unit]
Description=KayanGPU Worker (Video/LipSync GPU Worker for Nashash)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/KayanGPU
EnvironmentFile=/home/ubuntu/KayanGPU/.env
ExecStart=/home/ubuntu/KayanGPU/venv/bin/python3 /home/ubuntu/KayanGPU/worker/server.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/KayanGPU/worker/outputs /home/ubuntu/KayanGPU/worker/logs

[Install]
WantedBy=multi-user.target
